# Reference / research material (read-only, never part of the build)
temp/

# Local MVP data (projects, received files) — local single-user storage
.local-data/

# Dependencies
node_modules/
.pnpm-store/

# Next.js
.next/
out/
# Regenerated by `next dev` / `next build`; flips between the dev and build
# variants on every run, so it is noise in the diff.
next-env.d.ts

# Test / coverage
coverage/

# Misc
*.tsbuildinfo
.DS_Store

# CLI session logs
kimi-resume.log

# Local editor / assistant config
.cursor/
